# Base URL of the C# Web API. Change this to the IIS address after deployment.
VITE_API_BASE_URL=http://localhost:5205

# Google Maps JavaScript API key - enables the map picker on the Microgrid Nodes page.
# Leave empty to fall back to typing latitude / longitude by hand.
VITE_GOOGLE_MAPS_API_KEY=
# Optional map id for advanced markers; Google's DEMO_MAP_ID is used when empty.
VITE_GOOGLE_MAPS_MAP_ID=
