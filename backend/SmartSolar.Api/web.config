<?xml version="1.0" encoding="utf-8"?>
<!--
  -----------------------------------------------------------------------------
  File        : web.config
  Project     : Smart Solar Microgrid Trading System - Web Service
  Description : IIS hosting configuration. The ASP.NET Core Module runs the
                published DLL in-process. Install the "ASP.NET Core 9.0 Hosting
                Bundle" on the server, publish into an IIS site folder, and point
                the application pool at "No Managed Code".
  -----------------------------------------------------------------------------
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\SmartSolar.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
