<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest for the Smart Solar native Android client.
  Declares the internet, camera and location permissions required by the API
  calls, the QR scanner and the Google Maps node screen.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The camera is only needed by the operator QR scanner, so phones without one can still install the app. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SmartSolar">

        <!-- Google Maps Android API key, supplied from local.properties. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.ProsumerHomeActivity" android:exported="false" />
        <activity android:name=".ui.OperatorHomeActivity" android:exported="false" />
        <activity android:name=".ui.ReservationsActivity" android:exported="false" />
        <activity android:name=".ui.StationMapActivity" android:exported="false" />
        <activity android:name=".ui.BookingFormActivity" android:exported="false" />
        <activity android:name=".ui.BookingDetailActivity" android:exported="false" />
        <activity android:name=".ui.SummaryActivity" android:exported="false" />
        <activity android:name=".ui.ProfileActivity" android:exported="false" />

    </application>
</manifest>
