<?xml version="1.0" encoding="utf-8"?>
<!-- Text field border: dark amber when focused, slate otherwise - as on the web forms. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/brand_strong" android:state_focused="true" />
    <item android:color="@color/navy" android:state_hovered="true" />
    <item android:alpha="0.38" android:color="@color/navy" android:state_enabled="false" />
    <item android:color="@color/outline" />
</selector>
