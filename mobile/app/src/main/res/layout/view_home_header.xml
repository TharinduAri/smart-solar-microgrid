<?xml version="1.0" encoding="utf-8"?>
<!-- Navy header of the home screens: the Smart Solar mark (as in the web portal's drawer), the user's name and sign out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/navy"
    android:gravity="center_vertical"
    android:minHeight="?attr/actionBarSize"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <ImageView
        style="@style/Widget.SmartSolar.IconBadge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:backgroundTint="@color/brand_on_navy"
        android:src="@drawable/ic_sun"
        app:tint="@color/brand" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/navy_text" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSignOut"
        style="@style/Widget.SmartSolar.Button.HeaderIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/sign_out"
        app:icon="@drawable/ic_logout" />
</LinearLayout>
