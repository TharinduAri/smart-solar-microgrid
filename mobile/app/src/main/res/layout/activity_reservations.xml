<?xml version="1.0" encoding="utf-8"?>
<!-- Booking list with the status search filter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/inputStatusFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_status_filter"
            android:inputType="text"
            android:autofillHints="" />

        <Button
            android:id="@+id/buttonSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/solar_amber"
            android:text="@string/search"
            android:textColor="@color/grid_navy" />
    </LinearLayout>

    <ListView
        android:id="@+id/listReservations"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:divider="@color/text_muted"
        android:dividerHeight="1dp" />
</LinearLayout>
