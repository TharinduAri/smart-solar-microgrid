<?xml version="1.0" encoding="utf-8"?>
<!-- Prosumer dashboard with the live reservation counts and the main actions. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:textColor="@color/grid_navy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <include layout="@layout/dashboard_counts" />

        <Button
            android:id="@+id/buttonNewBooking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/solar_amber"
            android:text="@string/new_booking"
            android:textColor="@color/grid_navy" />

        <Button
            android:id="@+id/buttonMyBookings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/grid_navy"
            android:text="@string/my_bookings" />

        <Button
            android:id="@+id/buttonNearbyNodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/grid_navy"
            android:text="@string/nearby_nodes" />

        <Button
            android:id="@+id/buttonProfile"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="@color/grid_navy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/my_profile" />

        <Button
            android:id="@+id/buttonSignOut"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="@color/grid_navy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sign_out" />
    </LinearLayout>
</ScrollView>
