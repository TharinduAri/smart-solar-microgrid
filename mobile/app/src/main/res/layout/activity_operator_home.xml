<?xml version="1.0" encoding="utf-8"?>
<!-- Grid Operator home screen with the live counts, the QR scanner and the operational views. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:textColor="@color/grid_navy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <include layout="@layout/dashboard_counts" />

        <Button
            android:id="@+id/buttonScanQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/solar_amber"
            android:text="@string/scan_qr"
            android:textColor="@color/grid_navy" />

        <Button
            android:id="@+id/buttonBookings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/grid_navy"
            android:text="@string/all_bookings" />

        <Button
            android:id="@+id/buttonNodeMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/grid_navy"
            android:text="@string/node_map" />

        <Button
            android:id="@+id/buttonSignOut"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="@color/grid_navy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sign_out" />
    </LinearLayout>
</ScrollView>
