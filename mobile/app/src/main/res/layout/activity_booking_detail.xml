<?xml version="1.0" encoding="utf-8"?>
<!-- One booking in detail, with its QR code once approved and the allowed actions. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textStation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/grid_navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/solar_amber_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="6dp"
            android:padding="16dp"
            android:textColor="@color/grid_navy"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/imageQr"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/qr_description"
            android:padding="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textQrHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/qr_hint"
            android:textColor="@color/text_muted"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonApprove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/solar_amber"
            android:text="@string/approve_booking"
            android:textColor="@color/grid_navy"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonChange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/grid_navy"
            android:text="@string/change_booking"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="@color/grid_navy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cancel_booking"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/notice_12_hours"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
