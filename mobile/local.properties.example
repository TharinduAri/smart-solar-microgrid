# Copy to local.properties (which is git-ignored) and fill in your own values.
sdk.dir=C\:\\Users\\<you>\\AppData\\Local\\Android\\Sdk
MAPS_API_KEY=YOUR_GOOGLE_MAPS_ANDROID_API_KEY

# Backend API URL:
# 1. Physical Android Phone connected via USB (default, uses 'adb reverse tcp:5205 tcp:5205'):
#    API_BASE_URL=http://127.0.0.1:5205
# 2. Android Emulator:
#    API_BASE_URL=http://10.0.2.2:5205
# 3. Physical phone over local Wi-Fi without USB cable:
#    API_BASE_URL=http://192.168.x.x:5205
API_BASE_URL=http://127.0.0.1:5205
