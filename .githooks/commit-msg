#!/bin/sh
# -----------------------------------------------------------------------------
# Git Commit-Msg Hook: Smart Solar Microgrid Trading System
# Enforces Conventional Commits formatting: <type>(<scope>): <subject>
# -----------------------------------------------------------------------------

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# Allow standard Git merge commits through
if echo "$COMMIT_MSG" | grep -qE "^Merge "; then
    exit 0
fi

# Conventional Commit Regex
# Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_\.-]+\))?!?: .{1,100}$"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo "========================================================"
    echo "❌ [COMMIT-MSG ERROR] Invalid commit message format!"
    echo "========================================================"
    echo ""
    echo "Your commit message was:"
    echo "  \"$COMMIT_MSG\""
    echo ""
    echo "Commit messages must follow the Conventional Commits format:"
    echo "  <type>(<optional scope>): <description>"
    echo ""
    echo "Allowed types:"
    echo "  feat     - A new feature (e.g. feat(web): add slot management)"
    echo "  fix      - A bug fix (e.g. fix(api): enforce 12 hour rule)"
    echo "  docs     - Documentation only (e.g. docs: update developer guide)"
    echo "  style    - Formatting or styles without logic changes"
    echo "  refactor - Code change that neither fixes a bug nor adds a feature"
    echo "  perf     - A code change that improves performance"
    echo "  test     - Adding or correcting tests"
    echo "  build    - Changes that affect the build system or dependencies"
    echo "  ci       - Changes to CI/CD configuration"
    echo "  chore    - Tooling, hooks, or repository maintenance"
    echo "  revert   - Reverting a previous commit"
    echo ""
    echo "Examples:"
    echo "  feat(web): add slot schedule drawer to stations page"
    echo "  fix(backend): validate 7-day reservation window"
    echo "  chore(git): configure pre-commit and commit-msg hooks"
    echo "========================================================"
    exit 1
fi

exit 0
